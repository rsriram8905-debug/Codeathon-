# Copy this file to .env for local development (python-dotenv is not wired
# in by default - most hosts, including Render/Railway/Fly, inject these as
# real environment variables instead, so .env is only a local convenience).

# Port the app listens on. Most hosts set this for you automatically.
PORT=5000

# Set to 1 to enable Flask's debugger/auto-reload. Never enable in production.
FLASK_DEBUG=0

# Max upload size in MB.
MAX_UPLOAD_MB=25

# How many datasets to keep in memory before evicting the oldest.
MAX_DATASETS=20

# Comma-separated list of origins allowed to call /api/* (leave blank to
# allow all origins - fine when the dashboard is served from this same app).
ALLOWED_ORIGINS=
